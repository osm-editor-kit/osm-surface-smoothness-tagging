{
  "name": "osm-surface-smoothness-tagging",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run extract && bun run build:packages && bun run build:mobile && bun run --cwd apps/demo build",
    "build:mobile": "bun run scripts/build-mobile-assets.ts",
    "build:packages": "bun run --cwd packages/data build && bun run --cwd packages/id-field build",
    "check": "bun run build:packages && bun run --filter '*' check && bun run check-exports",
    "check-exports": "bun run --filter @osm-editor-kit/surface-smoothness-data check-exports && bun run --filter @osm-editor-kit/surface-smoothness-id-field check-exports",
    "dev:demo": "bun run --cwd apps/demo dev",
    "dev:id-field": "bun run --cwd packages/id-field dev",
    "extract": "bun run scripts/extract-from-streetcomplete.ts",
    "format": "bun run --filter '*' format",
    "format-check": "bun run --filter '*' format-check",
    "lint": "bun run --filter '*' lint",
    "lint-check": "bun run --filter '*' lint-check",
    "prepare": "husky",
    "release": "bun run scripts/release.ts",
    "sync:id-worktree": "bun run --cwd packages/id-field sync:id-worktree",
    "test-run": "bun run --filter '*' test-run",
    "type-check": "bun run --filter '*' type-check",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@osm-editor-kit/surface-smoothness-data": "workspace:*",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "packageManager": "bun@1.4.4"
}
