{
  "name": "@osm-editor-kit/surface-smoothness-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "bun run format-check && bun run lint-check && bun run type-check && bun run test-run",
    "dev": "vite",
    "format": "oxfmt --config ../../oxfmt.config.mjs --write .",
    "format-check": "oxfmt --config ../../oxfmt.config.mjs --check .",
    "lint": "oxlint --fix -c ../../oxlint.config.mjs .",
    "lint-check": "oxlint -c ../../oxlint.config.mjs .",
    "test-run": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@osm-editor-kit/surface-smoothness-data": "workspace:*",
    "@osm-editor-kit/surface-smoothness-id-field": "workspace:*",
    "d3-selection": "~3.0.0"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.11",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  }
}
