{
  "name": "@osm-editor-kit/surface-smoothness-id-field",
  "version": "0.0.0",
  "description": "D3-based iD inspector field for combined surface + smoothness tagging",
  "homepage": "https://github.com/osm-editor-kit/surface-smoothness-tagging/tree/main/packages/id-field#readme",
  "bugs": {
    "url": "https://github.com/osm-editor-kit/surface-smoothness-tagging/issues"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osm-editor-kit/surface-smoothness-tagging.git",
    "directory": "packages/id-field"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/surface-smoothness-field.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/surface-smoothness-field.esm.js",
      "default": "./dist/surface-smoothness-field.esm.js"
    },
    "./surface-smoothness-field.css": "./dist/surface-smoothness-field.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bleach": "rm -rf node_modules dist",
    "build": "bun run build:js && bun run build:css && bun run build:types",
    "build:css": "cp src/surface-smoothness-field.css dist/surface-smoothness-field.css",
    "build:js": "vite build --config vite.esm.config.ts && vite build --config vite.iife.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "bun run format:check && bun run lint && bun run type-check && bun run test",
    "dev": "bun run scripts/dev.ts",
    "format": "oxfmt --config ../../oxfmt.config.mjs --write .",
    "format:check": "oxfmt --config ../../oxfmt.config.mjs --check .",
    "lint": "oxlint -c ../../oxlint.config.mjs .",
    "sync:id-worktree": "bun run scripts/sync-to-id-worktree.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@osm-editor-kit/surface-smoothness-data": "workspace:*",
    "d3-dispatch": "~3.0.1",
    "d3-selection": "~3.0.0"
  },
  "devDependencies": {
    "@types/d3-dispatch": "^3.0.7",
    "@types/d3-selection": "^3.0.11",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  }
}
